---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Stack from '../components/layout/Stack.astro';
import ProductsHero from '../components/products/ProductsHero.astro';
import ProductList from '../components/products/ProductList.jsx';
import pesticidesData from '../data/pesticides.json';
import fertilizersData from '../data/fertilizers.json';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isArabic = lang === 'ar';

const allProducts = [
  ...pesticidesData.subcategories.flatMap(subcat => 
    subcat.products.map(product => ({
      ...product,
      categoryId: subcat.id
    }))
  ),
  ...fertilizersData.subcategories.flatMap(subcat => 
    subcat.products.map(product => ({
      ...product,
      categoryId: subcat.id
    }))
  )
];

const categories = [
  ...pesticidesData.subcategories.map(subcat => ({
    id: subcat.id,
    name: subcat.name
  })),
  ...fertilizersData.subcategories.map(subcat => ({
    id: subcat.id,
    name: subcat.name
  }))
];
---

<Layout title={t('products.title')}>
  <!-- Hero Carousel Section -->
  <ProductsHero 
    title={isArabic ? 'منتجاتنا الزراعية' : 'Our Agricultural Products'}
    subtitle={isArabic ? 'حلول متكاملة للبذور والأسمدة والمبيدات من شركاء عالميين موثوقين' : 'Complete solutions for seeds, fertilizers, and pesticides from trusted global partners'}
    isArabic={isArabic}
  />

  <!-- Products List Section -->
  <PageWrapper>
    <ProductList client:load products={allProducts} categories={categories} lang={lang} />
  </PageWrapper>
</Layout>
