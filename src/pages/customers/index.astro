---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import Kicker from '../../components/editorial/Kicker.astro';
import CustomerCard from '../../components/customers/CustomerCard.astro';
import { customers } from '../../data/customers';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'ar' ? '/ar/' : '/';
---
<Layout title={t('customers.page.title')}>
  <Breadcrumb items={[{ label: t('nav.home'), href: homeHref }, { label: t('customers.page.title') }]} />

  <header class="px-page-x pb-section-y">
    <Kicker label={t('customers.page.kicker')} accent="sienna" />
    <h1 class="font-display text-[clamp(48px,7vw,112px)] leading-[0.95] text-ink mt-sp-5 max-w-[22ch] mb-sp-7">
      {t('customers.page.headline')}
    </h1>
    <p class="font-sans text-lg text-ink/80 max-w-[64ch] leading-relaxed">
      {t('customers.page.deck')}
    </p>
  </header>

  <section class="px-page-x pb-section-y">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-sp-7">
      {customers.map((customer) => <CustomerCard customer={customer} />)}
    </div>
  </section>
</Layout>
