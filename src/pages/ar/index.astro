  <FeaturedReport />
  <CaptionStrip sectionNumber="٠٤ / ٠٩" label="من الحقل" subLabel="ثلاثة تقارير · هذا الإصدار" />
  <ThreeReportsGrid />
  <CaptionStrip sectionNumber="٠٥ / ٠٩" label="المصادر · بيوت الشراكة" />
  <SourcesSection />
  <CaptionStrip sectionNumber="٠٦ / ٠٩" label="بالأرقام" subLabel="العمليات والانتشار" />
  <ByTheNumbers />
  <CaptionStrip sectionNumber="٠٧ / ٠٩" label="الكتالوج" subLabel="أربعة رفوف · ١٤ منتجاً" />
