---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/home/Hero.astro';
import OpsTicker from '../../components/home/OpsTicker.astro';
import EditorsNote from '../../components/home/EditorsNote.astro';
import FeaturedReport from '../../components/home/FeaturedReport.astro';
import ThreeReportsGrid from '../../components/home/ThreeReportsGrid.astro';
import SourcesSection from '../../components/home/SourcesSection.astro';
import CustomersStrip from '../../components/home/CustomersStrip.astro';
import ByTheNumbers from '../../components/home/ByTheNumbers.astro';
import CatalogTable from '../../components/home/CatalogTable.astro';
import HomeCTA from '../../components/home/HomeCTA.astro';
import CaptionStrip from '../../components/global/CaptionStrip.astro';
---

<Layout>
  <Hero />
  <CaptionStrip sectionNumber="٠١ / ١٠" label="العمليات" subLabel="مباشر · هذا الأسبوع" />
  <OpsTicker />
  <CaptionStrip sectionNumber="٠٢ / ١٠" label="افتتاحية المحرّر" subLabel="إصدار ٠٣ · ٢٠٢٦ · العائد" />
  <EditorsNote />
  <CaptionStrip sectionNumber="٠٣ / ١٠" label="تقرير حقلي مميّز" />
  <FeaturedReport />
  <CaptionStrip sectionNumber="٠٤ / ١٠" label="من الحقل" subLabel="ثلاثة تقارير · هذا الإصدار" />
  <ThreeReportsGrid />
  <CaptionStrip sectionNumber="٠٥ / ١٠" label="المصادر · سبع شراكات دولية" />
  <SourcesSection />
  <CaptionStrip sectionNumber="٠٦ / ١٠" label="جدار العملاء" subLabel="ستة عملاء مرجعيون · السودان" />
  <CustomersStrip />
  <CaptionStrip sectionNumber="٠٧ / ١٠" label="بالأرقام" subLabel="الفروع والانتشار" />
  <ByTheNumbers />
  <CaptionStrip sectionNumber="٠٨ / ١٠" label="الكتالوج" subLabel="ثلاثة خطوط · بذور وأسمدة ومبيدات" />
  <CatalogTable />
  <CaptionStrip sectionNumber="٠٩ / ١٠" label="أرسل تقرير التربة" />
  <HomeCTA />
</Layout>
