---
/**
 * Privacy Policy Page - Arabic
 * سياسة الخصوصية الشاملة لأعمال زاغروس للتجارة
 */

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<Layout title="سياسة الخصوصية - أعمال زاغروس للتجارة">
  <div class="bg-white py-16 md:py-24" dir="rtl">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4 font-arabic">سياسة الخصوصية</h1>
        <p class="text-text-secondary font-arabic">آخر تحديث: يناير 2026</p>
      </div>

      <!-- Content -->
      <div class="prose prose-lg max-w-none space-y-8 font-arabic">
        
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">1. المقدمة</h2>
          <p class="text-text-secondary leading-relaxed">
            تلتزم أعمال زاغروس للتجارة ("نحن" أو "لنا") بحماية خصوصيتك. توضح سياسة الخصوصية هذه كيفية جمعنا واستخدامنا والكشف عن معلوماتك وحمايتها عند زيارة موقعنا الإلكتروني أو التعامل مع خدماتنا.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">2. المعلومات التي نجمعها</h2>
          <h3 class="text-xl font-semibold text-text-primary mb-3">2.1 المعلومات الشخصية</h3>
          <p class="text-text-secondary leading-relaxed mb-4">
            قد نجمع المعلومات الشخصية التي تقدمها لنا طوعاً عندما:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li>تتواصل معنا عبر موقعنا الإلكتروني أو البريد الإلكتروني</li>
            <li>تطلب معلومات عن المنتجات أو عروض الأسعار</li>
            <li>تسجل للحصول على شراكات تجارية</li>
            <li>تشترك في نشرتنا الإخبارية أو التحديثات</li>
          </ul>
          <p class="text-text-secondary leading-relaxed mt-4">
            قد تتضمن هذه المعلومات: الاسم، اسم الشركة، عنوان البريد الإلكتروني، رقم الهاتف، عنوان العمل، وأي معلومات أخرى تختار تقديمها.
          </p>

          <h3 class="text-xl font-semibold text-text-primary mb-3 mt-6">2.2 المعلومات المجمعة تلقائياً</h3>
          <p class="text-text-secondary leading-relaxed">
            عند زيارة موقعنا الإلكتروني، قد نجمع تلقائياً معلومات معينة عن جهازك، بما في ذلك معلومات عن متصفح الويب الخاص بك، وعنوان IP، والمنطقة الزمنية، وبعض ملفات تعريف الارتباط المثبتة على جهازك.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">3. كيفية استخدام معلوماتك</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            نستخدم المعلومات التي نجمعها من أجل:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li>الرد على استفساراتك وتقديم دعم العملاء</li>
            <li>معالجة وتلبية طلباتك التجارية</li>
            <li>إرسال معلومات المنتجات والتحديثات التجارية</li>
            <li>تحسين موقعنا الإلكتروني وخدماتنا</li>
            <li>الامتثال للالتزامات القانونية</li>
            <li>منع الاحتيال وتعزيز الأمان</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">4. مشاركة المعلومات والإفصاح عنها</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            نحن لا نبيع أو نتاجر أو نؤجر معلوماتك الشخصية لأطراف ثالثة. قد نشارك معلوماتك فقط في الظروف التالية:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li><strong>الشركاء التجاريون:</strong> مع موزعينا وشركائنا المعتمدين عند الضرورة لتلبية طلباتك</li>
            <li><strong>مقدمو الخدمات:</strong> مع مقدمي الخدمات من الأطراف الثالثة الذين يساعدوننا في تشغيل موقعنا وإدارة أعمالنا</li>
            <li><strong>المتطلبات القانونية:</strong> عندما يتطلب القانون ذلك أو لحماية حقوقنا وسلامتنا</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">5. أمن البيانات</h2>
          <p class="text-text-secondary leading-relaxed">
            نطبق تدابير أمنية تقنية وتنظيمية مناسبة لحماية معلوماتك الشخصية من الوصول غير المصرح به أو التعديل أو الكشف أو التدمير. ومع ذلك، لا توجد طريقة نقل عبر الإنترنت أو تخزين إلكتروني آمنة بنسبة 100٪.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">6. الاحتفاظ بالبيانات</h2>
          <p class="text-text-secondary leading-relaxed">
            نحتفظ بمعلوماتك الشخصية فقط طالما كان ذلك ضرورياً لتحقيق الأغراض الموضحة في سياسة الخصوصية هذه، ما لم تكن هناك حاجة لفترة احتفاظ أطول أو يسمح بها القانون.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">7. حقوقك</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            لديك الحق في:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li>الوصول إلى المعلومات الشخصية التي نحتفظ بها عنك</li>
            <li>طلب تصحيح المعلومات غير الدقيقة</li>
            <li>طلب حذف معلوماتك الشخصية</li>
            <li>الاعتراض على معالجة معلوماتك الشخصية</li>
            <li>سحب الموافقة في أي وقت</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">8. ملفات تعريف الارتباط</h2>
          <p class="text-text-secondary leading-relaxed">
            نستخدم ملفات تعريف الارتباط وتقنيات التتبع المماثلة لتحسين تجربة التصفح الخاصة بك، وتحليل حركة المرور على الموقع، وفهم من أين يأتي زوارنا. يمكنك التحكم في ملفات تعريف الارتباط من خلال إعدادات المتصفح الخاص بك.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">9. نقل البيانات الدولية</h2>
          <p class="text-text-secondary leading-relaxed">
            قد يتم نقل معلوماتك والاحتفاظ بها على خوادم موجودة خارج بلدك. نضمن وجود ضمانات مناسبة لحماية معلوماتك وفقاً لسياسة الخصوصية هذه.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">10. التغييرات على سياسة الخصوصية هذه</h2>
          <p class="text-text-secondary leading-relaxed">
            قد نقوم بتحديث سياسة الخصوصية هذه من وقت لآخر. سنخطرك بأي تغييرات من خلال نشر سياسة الخصوصية الجديدة على هذه الصفحة وتحديث تاريخ "آخر تحديث".
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">11. اتصل بنا</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            إذا كان لديك أي أسئلة حول سياسة الخصوصية هذه أو ممارسات الخصوصية لدينا، يرجى الاتصال بنا:
          </p>
          <div class="bg-stone-50 p-6 rounded-lg">
            <p class="text-text-secondary"><strong>أعمال زاغروس للتجارة</strong></p>
            <p class="text-text-secondary">البريد الإلكتروني: info@zagros-agriculture.com</p>
            <p class="text-text-secondary">الهاتف: +249 123 456 789</p>
            <p class="text-text-secondary">العنوان: الخرطوم، السودان</p>
          </div>
        </section>

      </div>
    </div>
  </div>
</Layout>
