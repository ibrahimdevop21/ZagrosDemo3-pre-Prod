---
/**
 * Terms & Conditions Page - Arabic
 * الشروط والأحكام الشاملة لأعمال زاغروس للتجارة
 */

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<Layout title="الشروط والأحكام - أعمال زاغروس للتجارة">
  <div class="bg-white py-16 md:py-24" dir="rtl">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4 font-arabic">الشروط والأحكام</h1>
        <p class="text-text-secondary font-arabic">آخر تحديث: يناير 2026</p>
      </div>

      <!-- Content -->
      <div class="prose prose-lg max-w-none space-y-8 font-arabic">
        
        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">1. الموافقة على الشروط</h2>
          <p class="text-text-secondary leading-relaxed">
            من خلال الوصول إلى موقع أعمال زاغروس للتجارة واستخدام خدماتنا، فإنك توافق على الالتزام بهذه الشروط والأحكام. إذا كنت لا توافق على أي جزء من هذه الشروط، فلا يجوز لك الوصول إلى موقعنا أو استخدام خدماتنا.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">2. الخدمات التجارية</h2>
          <h3 class="text-xl font-semibold text-text-primary mb-3">2.1 المنتجات والخدمات</h3>
          <p class="text-text-secondary leading-relaxed mb-4">
            تقدم أعمال زاغروس للتجارة منتجات وخدمات زراعية تشمل:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li>استيراد وتوزيع المدخلات الزراعية (الأسمدة، البذور، المبيدات)</li>
            <li>خدمات تسجيل المبيدات والامتثال التنظيمي</li>
            <li>عمليات التجارة الدولية</li>
            <li>خدمات الاستشارات الزراعية</li>
          </ul>

          <h3 class="text-xl font-semibold text-text-primary mb-3 mt-6">2.2 معلومات المنتج</h3>
          <p class="text-text-secondary leading-relaxed">
            نسعى جاهدين لتقديم معلومات دقيقة عن المنتجات والمواصفات والأسعار. ومع ذلك، لا نضمن أن أوصاف المنتجات أو الأسعار أو المحتوى الآخر على موقعنا دقيق أو كامل أو موثوق أو حالي أو خالٍ من الأخطاء.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">3. المعاملات التجارية</h2>
          <h3 class="text-xl font-semibold text-text-primary mb-3">3.1 عروض الأسعار والطلبات</h3>
          <p class="text-text-secondary leading-relaxed">
            جميع عروض الأسعار المقدمة صالحة للفترة المحددة وتخضع للتوافر. الطلبات تخضع للقبول والتأكيد من قبل أعمال زاغروس للتجارة.
          </p>

          <h3 class="text-xl font-semibold text-text-primary mb-3 mt-6">3.2 التسعير والدفع</h3>
          <p class="text-text-secondary leading-relaxed">
            الأسعار قابلة للتغيير دون إشعار مسبق. سيتم تحديد شروط الدفع في العقود الفردية أو أوامر الشراء. جميع الأسعار لا تشمل الضرائب المطبقة ما لم ينص على خلاف ذلك.
          </p>

          <h3 class="text-xl font-semibold text-text-primary mb-3 mt-6">3.3 التسليم</h3>
          <p class="text-text-secondary leading-relaxed">
            سيتم تحديد شروط التسليم والجداول الزمنية والمسؤوليات في العقود الفردية. نحن غير مسؤولين عن التأخيرات الناجمة عن ظروف خارجة عن سيطرتنا المعقولة.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">4. جودة المنتج والضمانات</h2>
          <h3 class="text-xl font-semibold text-text-primary mb-3">4.1 معايير الجودة</h3>
          <p class="text-text-secondary leading-relaxed">
            جميع المنتجات التي توفرها أعمال زاغروس للتجارة تلبي معايير الجودة المطبقة والمتطلبات التنظيمية. يتم الحصول على المنتجات من مصنعين دوليين ذوي سمعة طيبة.
          </p>

          <h3 class="text-xl font-semibold text-text-primary mb-3 mt-6">4.2 الضمانات</h3>
          <p class="text-text-secondary leading-relaxed">
            ضمانات المنتج، إن وجدت، يتم توفيرها من قبل الشركات المصنعة. ستقوم أعمال زاغروس للتجارة بتسهيل مطالبات الضمان ولكنها ليست مسؤولة مباشرة عن ضمانات الشركات المصنعة.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">5. الملكية الفكرية</h2>
          <p class="text-text-secondary leading-relaxed">
            جميع المحتويات على هذا الموقع، بما في ذلك النصوص والرسومات والشعارات والصور والبرامج، هي ملك لأعمال زاغروس للتجارة أو موفري المحتوى الخاصين بها ومحمية بموجب قوانين الملكية الفكرية. لا يجوز لك إعادة إنتاج أو توزيع أو إنشاء أعمال مشتقة دون إذن كتابي صريح منا.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">6. تحديد المسؤولية</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            إلى أقصى حد يسمح به القانون:
          </p>
          <ul class="list-disc list-inside text-text-secondary space-y-2 mr-4">
            <li>لن تكون أعمال زاغروس للتجارة مسؤولة عن أي أضرار غير مباشرة أو عرضية أو خاصة أو تبعية</li>
            <li>لن تتجاوز مسؤوليتنا الإجمالية المبلغ الذي دفعته مقابل المنتج أو الخدمة المحددة</li>
            <li>نحن غير مسؤولين عن التأخيرات أو الإخفاقات بسبب ظروف خارجة عن سيطرتنا المعقولة</li>
          </ul>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">7. التعويض</h2>
          <p class="text-text-secondary leading-relaxed">
            توافق على تعويض وحماية أعمال زاغروس للتجارة ومسؤوليها ومديريها وموظفيها ووكلائها من أي مطالبات أو أضرار أو خسائر أو التزامات ونفقات ناشئة عن استخدامك لخدماتنا أو انتهاك هذه الشروط.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">8. الامتثال التنظيمي</h2>
          <p class="text-text-secondary leading-relaxed">
            العملاء مسؤولون عن ضمان الامتثال لجميع القوانين واللوائح المعمول بها في ولايتهم القضائية فيما يتعلق باستخدام وتخزين وتطبيق المنتجات الزراعية المشتراة من أعمال زاغروس للتجارة.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">9. الإنهاء</h2>
          <p class="text-text-secondary leading-relaxed">
            نحتفظ بالحق في إنهاء أو تعليق الوصول إلى خدماتنا فوراً، دون إشعار مسبق، لأي انتهاك لهذه الشروط والأحكام.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">10. القانون الحاكم</h2>
          <p class="text-text-secondary leading-relaxed">
            تخضع هذه الشروط والأحكام وتفسر وفقاً لقوانين السودان. أي نزاعات ناشئة عن هذه الشروط تخضع للاختصاص القضائي الحصري لمحاكم السودان.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">11. التغييرات على الشروط</h2>
          <p class="text-text-secondary leading-relaxed">
            نحتفظ بالحق في تعديل هذه الشروط والأحكام في أي وقت. ستكون التغييرات سارية فوراً عند نشرها على هذا الموقع. استمرارك في استخدام خدماتنا يشكل قبولاً للشروط المعدلة.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">12. قابلية الفصل</h2>
          <p class="text-text-secondary leading-relaxed">
            إذا تبين أن أي حكم من هذه الشروط والأحكام غير صالح أو غير قابل للتنفيذ، فستظل الأحكام المتبقية سارية المفعول بالكامل.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-text-primary mb-4">13. معلومات الاتصال</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            للأسئلة المتعلقة بهذه الشروط والأحكام، يرجى الاتصال بنا:
          </p>
          <div class="bg-stone-50 p-6 rounded-lg">
            <p class="text-text-secondary"><strong>أعمال زاغروس للتجارة</strong></p>
            <p class="text-text-secondary">البريد الإلكتروني: info@zagros-agriculture.com</p>
            <p class="text-text-secondary">الهاتف: +249 123 456 789</p>
            <p class="text-text-secondary">العنوان: الخرطوم، السودان</p>
          </div>
        </section>

      </div>
    </div>
  </div>
</Layout>
