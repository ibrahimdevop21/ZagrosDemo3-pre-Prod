---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import Kicker from '../../components/editorial/Kicker.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import DirectContact from '../../components/contact/DirectContact.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'ar' ? '/ar/' : '/';
---
<Layout title={t('contact.title')}>
  <Breadcrumb items={[{ label: t('nav.home'), href: homeHref }, { label: t('contact.title') }]} />

  <header class="pb-sp-9">
    <div class="container-spine">
      <Kicker label={t('contact.kicker')} accent="signal" />
      <h1 class="font-display italic font-light text-[clamp(40px,6vw,84px)] leading-[1.02] text-ink mt-sp-5 max-w-[24ch] mb-sp-7">{t('contact.headline')}</h1>
      <p class="font-sans text-lg text-ink/80 max-w-[60ch]">{t('contact.deck')}</p>
    </div>
  </header>

  <section class="pb-section-y">
    <div class="container-spine">
      <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-sp-9">
        <ContactForm />
        <DirectContact />
      </div>
    </div>
  </section>
</Layout>
