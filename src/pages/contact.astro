---
import Layout from '../layouts/Layout.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import Stack from '../components/layout/Stack.astro';
import { companyData } from '../data/company.ts';
import { getLangFromUrl } from '../i18n/utils';
import GlobalMap from '../components/contact/GlobalMap.jsx';

const lang = getLangFromUrl(Astro.url);
const isArabic = lang === 'ar';
---

<Layout title="Contact Us">
	<PageWrapper>
		<Section spacing="md">
			<Container>
				<Stack spacing="xl">
					<h1 class="text-4xl font-bold text-center text-text-primary">Contact Us</h1>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
						<Stack spacing="lg">
							<Stack spacing="md">
								<h2 class="text-2xl font-bold text-text-primary">Get in Touch</h2>
								<Stack spacing="sm">
									<div>
										<h3 class="font-semibold text-text-primary mb-2">Address:</h3>
										<p class="text-text-secondary">{companyData.company.contact.address}</p>
									</div>
									<div>
										<h3 class="font-semibold text-text-primary mb-2">Email:</h3>
										<p class="text-text-secondary">{companyData.company.contact.email}</p>
									</div>
									<div>
										<h3 class="font-semibold text-text-primary mb-2">Phone Numbers:</h3>
										<ul class="space-y-1 text-text-secondary">
											{companyData.company.contact.telephones.map(phone => (
												<li>{phone}</li>
											))}
										</ul>
									</div>
								</Stack>
							</Stack>

							<Stack spacing="md">
								<h2 class={`text-2xl font-bold text-text-primary ${isArabic ? 'font-arabic text-right' : ''}`}>
									{isArabic ? 'فروعنا' : 'Our Branches'}
								</h2>
								<ul class="grid grid-cols-2 gap-4">
									{companyData.company.branches.map(branch => (
										<li class={`bg-bg-surface-muted text-text-secondary p-3 rounded ${isArabic ? 'font-arabic text-right' : ''}`}>
											<a 
												href={branch.mapUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="hover:text-text-brand transition-colors"
											>
												{isArabic ? branch.name_ar : branch.name}
												{branch.type === 'Headquarters' && (
													<span class="text-xs text-text-tertiary ml-1">
														{isArabic ? ' (المقر)' : ' (HQ)'}
													</span>
												)}
											</a>
										</li>
									))}
								</ul>
							</Stack>
						</Stack>

						<Stack spacing="md">
							<h2 class="text-2xl font-bold text-text-primary">Send us a Message</h2>
							<form class="space-y-4">
								<div>
									<label for="name" class="block text-sm font-medium text-text-primary mb-1">Name</label>
									<input
										type="text"
										id="name"
										name="name"
										class="w-full px-4 py-2 border border-border-default rounded-md focus:ring-brand-primary focus:border-brand-primary bg-bg-surface text-text-primary"
										required
									/>
								</div>
								<div>
									<label for="email" class="block text-sm font-medium text-text-primary mb-1">Email</label>
									<input
										type="email"
										id="email"
										name="email"
										class="w-full px-4 py-2 border border-border-default rounded-md focus:ring-brand-primary focus:border-brand-primary bg-bg-surface text-text-primary"
										required
									/>
								</div>
								<div>
									<label for="subject" class="block text-sm font-medium text-text-primary mb-1">Subject</label>
									<input
										type="text"
										id="subject"
										name="subject"
										class="w-full px-4 py-2 border border-border-default rounded-md focus:ring-brand-primary focus:border-brand-primary bg-bg-surface text-text-primary"
										required
									/>
								</div>
								<div>
									<label for="message" class="block text-sm font-medium text-text-primary mb-1">Message</label>
									<textarea
										id="message"
										name="message"
										rows="4"
										class="w-full px-4 py-2 border border-border-default rounded-md focus:ring-brand-primary focus:border-brand-primary bg-bg-surface text-text-primary"
										required
									></textarea>
								</div>
								<button
									type="submit"
									class="w-full bg-brand-primary text-text-inverse py-2 px-4 rounded-md hover:bg-brand-primary-hover transition duration-200"
								>
									Send Message
								</button>
							</form>
						</Stack>
					</div>

					<!-- Global Map Section -->
					<Stack spacing="md">
						<h2 class={`text-2xl font-bold text-text-primary text-center ${isArabic ? 'font-arabic' : ''}`}>
							{isArabic ? 'تواجدنا العالمي' : 'Our Global Presence'}
						</h2>
						<p class={`text-text-secondary text-center max-w-2xl mx-auto ${isArabic ? 'font-arabic' : ''}`}>
							{isArabic 
								? 'فروعنا في السودان (أخضر) وشركاؤنا وعملاؤنا العالميون (أصفر)'
								: 'Our branches in Sudan (green) and our global partners & customers (yellow)'
							}
						</p>
						<GlobalMap 
							client:load
							branches={companyData.company.branches}
							partners={companyData.company}
							customers={companyData.customers}
							lang={lang}
						/>
					</Stack>
				</Stack>
			</Container>
		</Section>
	</PageWrapper>
</Layout>
