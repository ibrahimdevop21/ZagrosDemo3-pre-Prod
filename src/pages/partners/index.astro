---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Breadcrumb from '../../components/global/Breadcrumb.astro';
import PartnerCard from '../../components/cards/PartnerCard.astro';
import Kicker from '../../components/editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const partners = await getCollection('partners');

type Partner = CollectionEntry<'partners'>;
const byCategory = (cat: Partner['data']['category']) =>
  partners.filter(p => p.data.category === cat);

const groups: { id: string; label: { en: string; ar: string }; rows: Partner[] }[] = [
  {
    id: 'seeds',
    label: { en: 'Seeds', ar: 'البذور' },
    rows: [...byCategory('vegetable_seeds'), ...byCategory('forage_seeds')],
  },
  {
    id: 'fertilizers',
    label: { en: 'Fertilizers', ar: 'الأسمدة' },
    rows: byCategory('fertilizers'),
  },
  {
    id: 'pesticides',
    label: { en: 'Pesticides', ar: 'حماية المحاصيل' },
    rows: byCategory('pesticides'),
  },
];
---
<Layout title={t('partners_page.title')}>
  <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: t('nav.partners') }]} />
  <header class="px-page-x pb-sp-9">
    <Kicker label={t('partners_page.kicker')} accent="sienna" />
    <h1 class="font-display text-[clamp(48px,7vw,96px)] leading-[0.95] text-ink mt-sp-5 max-w-[24ch] mb-sp-7">{t('partners_page.headline')}</h1>
    <p class="font-sans text-lg text-ink/80 max-w-[60ch]">{t('partners_page.deck')}</p>
  </header>
  <section class="px-page-x pb-section-y space-y-section-y">
    {groups.map(group => group.rows.length > 0 && (
      <div>
        <header class="flex items-baseline justify-between border-b border-stone pb-sp-5 mb-sp-7">
          <h2 class="font-display italic text-3xl text-ink">{group.label[lang as 'en' | 'ar']}</h2>
          <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute">
            {group.rows.length} {lang === 'ar' ? 'موردون' : 'suppliers'}
          </span>
        </header>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-sp-7">
          {group.rows.map(p => <PartnerCard partner={p} />)}
        </div>
      </div>
    ))}
  </section>
</Layout>
