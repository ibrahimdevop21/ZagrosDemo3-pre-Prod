---
/**
 * Stack - Vertical spacing between content elements
 * 
 * Responsibilities:
 * - Apply consistent vertical spacing between children
 * - Support responsive spacing
 * 
 * Does NOT control:
 * - Horizontal layout
 * - Background colors
 */

interface Props {
  spacing?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  as?: 'div' | 'ul' | 'ol';
  class?: string;
}

const { 
  spacing = 'sm', 
  as: Element = 'div',
  class: className = '' 
} = Astro.props;

const spacingClasses = {
  xs: 'space-y-content-xs',
  sm: 'space-y-content-sm',
  md: 'space-y-content-md',
  lg: 'space-y-content-lg',
  xl: 'space-y-content-xl',
};
---

<Element class={`${spacingClasses[spacing]} ${className}`}>
  <slot />
</Element>
