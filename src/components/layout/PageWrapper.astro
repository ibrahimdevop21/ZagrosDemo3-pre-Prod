---
/**
 * PageWrapper - Root container for page content
 * 
 * Responsibilities:
 * - Apply max-width constraint
 * - Center content horizontally
 * - Apply responsive horizontal padding
 * 
 * Does NOT control:
 * - Vertical spacing (Section handles this)
 * - Background colors
 * - Content layout
 */

interface Props {
  class?: string;
  maxWidth?: 'default' | 'wide' | 'narrow';
}

const { class: className = '', maxWidth = 'default' } = Astro.props;

const maxWidthClasses = {
  default: 'max-w-7xl',
  wide: 'max-w-screen-2xl',
  narrow: 'max-w-3xl',
};
---

<div class={`mx-auto px-4 md:px-6 lg:px-8 ${maxWidthClasses[maxWidth]} ${className}`}>
  <slot />
</div>
