---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="py-sp-5 font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute" aria-label="Breadcrumb">
  <div class="container-spine">
    <ol class="list-none p-0 m-0 inline-flex flex-wrap items-center gap-2">
      {items.map((crumb, i) => (
        <li class="inline-flex items-center gap-2">
          {crumb.href ? (
            <a href={crumb.href} class="motion-press text-ink no-underline border-b border-transparent hover:border-ink">{crumb.label}</a>
          ) : (
            <span class="text-ink/90">{crumb.label}</span>
          )}
          {i < items.length - 1 && <span class="text-mute" aria-hidden="true">/</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>
