---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { companyData } from '../../data/company';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRTL = lang === 'ar';

const year = new Date().getFullYear();

const phone = companyData.contact.phone;
const phoneTel = phone?.replace(/\s+/g, '');
const whatsapp = companyData.contact.whatsapp?.replace(/[^\d]/g, '');
---

<footer class="bg-ink text-paper border-t border-paper/10 pt-sp-9 pb-sp-8">
  <div class="container-spine">
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-4">
        <div class="flex items-center gap-4 mb-sp-6">
          <img
            src="/zagros-white.png"
            alt={t('site.name')}
            width="240"
            height="80"
            loading="lazy"
            decoding="async"
            class="h-12 w-auto block"
            style="mix-blend-mode: screen;"
          />
        </div>
        <p class="font-sans text-[15px] leading-relaxed text-paper/75 max-w-[36ch] mb-sp-7">
          {t('site.meta_description')}
        </p>
        <form class="news">
          <label class="block font-mono text-[10.5px] tracking-[0.22em] uppercase text-signal mb-sp-3">
            {t('footer.newsletter_label')}
          </label>
          <div class="flex gap-2">
            <input
              type="email"
              placeholder={t('footer.newsletter_placeholder')}
              class="motion-press flex-1 min-w-0 bg-transparent text-paper border border-paper/20 px-sp-4 py-sp-3 font-sans text-base min-h-[44px] outline-none focus:border-signal"
            />
            <button
              type="submit"
              class="motion-press shrink-0 bg-signal text-ink font-sans font-semibold text-[14px] px-sp-5 py-sp-3 min-h-[44px] border-none cursor-pointer hover:opacity-90"
            >
              {t('footer.newsletter_submit')}
            </button>
          </div>
        </form>
      </div>

      <div class="col-span-6 sm:col-span-4 lg:col-span-3 footer-col">
        <h5 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-5 font-medium m-0">
          {t('footer.col_catalog')}
        </h5>
        <ul class="list-none p-0 m-0">
          <li><a href={isRTL ? '/ar/products' : '/products'} class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">{t('nav.products')}</a></li>
          <li><a href={isRTL ? '/ar/field-reports' : '/field-reports'} class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">{t('nav.field_reports')}</a></li>
        </ul>
      </div>

      <div class="col-span-6 sm:col-span-4 lg:col-span-3 footer-col">
        <h5 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-5 font-medium m-0">
          {t('footer.col_company')}
        </h5>
        <ul class="list-none p-0 m-0">
          <li><a href={isRTL ? '/ar/about' : '/about'} class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">{t('nav.about')}</a></li>
          <li><a href={isRTL ? '/ar/contact' : '/contact'} class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <div class="col-span-12 sm:col-span-4 lg:col-span-2 footer-col">
        <h5 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-5 font-medium m-0">
          {t('footer.col_contact')}
        </h5>
        <ul class="list-none p-0 m-0 space-y-sp-3">
          <li class="font-sans text-[14px] text-paper/65 leading-snug">
            {t('footer.contact_location')}
          </li>
          {phone && (
            <li>
              <a href={`tel:${phoneTel}`} dir="ltr" class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">
                {phone}
              </a>
            </li>
          )}
          {whatsapp && (
            <li>
              <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noreferrer" class="motion-press inline-flex items-center min-h-[44px] text-paper/85 no-underline font-sans text-[15px] hover:text-paper">
                {t('footer.contact_whatsapp')}
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="col-span-12 mt-sp-7 pt-sp-5 border-t border-paper/10 flex flex-wrap justify-between gap-y-sp-3 font-mono text-[10.5px] tracking-[0.22em] uppercase text-paper/50">
        <span>{t('footer.copyright').replace('2026', String(year))}</span>
        <span>{t('common.section')} · {t('footer.colophon_section')} · {t('footer.colophon_label')}</span>
      </div>
    </div>
  </div>
</footer>
