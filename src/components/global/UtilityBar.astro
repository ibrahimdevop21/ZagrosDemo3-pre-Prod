---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { companyData } from '../../data/company';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const phone = companyData.contact.phone;
const phoneTel = phone?.replace(/\s+/g, '');
---

<div class="bg-ink text-paper/60 px-page-x py-2.5 font-mono text-[11px] uppercase tracking-[0.22em] flex justify-between items-center">
  <span class="inline-flex items-center gap-2.5">
    <span class="w-1.5 h-1.5 bg-signal rounded-full inline-block"></span>
    <span>{t('utility.service_area')} · {t('utility.hours_label')}</span>
  </span>
  <span class="hidden md:flex gap-5 opacity-90 items-center">
    {phone && <a href={`tel:${phoneTel}`} dir="ltr" class="inline-flex items-center min-h-[36px] text-paper/60 no-underline hover:text-paper">{phone}</a>}
    <span class="text-paper/40">·</span>
    <span>{t('utility.partners_label')}</span>
  </span>
</div>
