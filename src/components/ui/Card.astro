---
/**
 * Premium Card Component
 * Provides consistent elevation and spacing
 */

interface Props {
  variant?: 'default' | 'elevated' | 'bordered';
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { 
  variant = 'default',
  padding = 'md',
  class: className = '',
} = Astro.props;

const baseStyles = 'bg-bg-surface rounded-[var(--radius-xl)] transition-all duration-[var(--duration-normal)] ease-[var(--ease-in-out)]';

const variants = {
  default: 'shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)]',
  elevated: 'shadow-[var(--shadow-lg)] hover:shadow-[var(--shadow-xl)]',
  bordered: 'border border-border-default hover:border-border-brand',
};

const paddings = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const classes = `${baseStyles} ${variants[variant]} ${paddings[padding]} ${className}`;
---

<div class={classes}>
  <slot />
</div>
