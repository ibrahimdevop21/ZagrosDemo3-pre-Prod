---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isAR = lang === 'ar';

const products = await getCollection('products');
const subcategories = [
  { id: 'water-soluble-npk', label_en: 'K+S · Water-soluble NPK',  label_ar: 'K+S · أسمدة قابلة للذوبان' },
  { id: 'phosphate-sources', label_en: 'K+S · Phosphate sources',  label_ar: 'K+S · مصادر الفوسفور' },
  { id: 'nitrogen-mg-k',     label_en: 'K+S · Nitrogen + Mg + K',  label_ar: 'K+S · نيتروجين + مغنيسيوم + بوتاسيوم' },
  { id: 'barenbrug-forage',  label_en: 'Barenbrug · Forage',       label_ar: 'Barenbrug · أعلاف' },
];

const matches: Record<string, { count: number; samples: { name: string; grade: string }[] }> = {};
for (const { id } of subcategories) matches[id] = { count: 0, samples: [] };

for (const p of products) {
  const slug = p.slug;
  const bucket =
    p.data.brand === 'Barenbrug' ? 'barenbrug-forage'
    : ['solu-npk-20-20-20', 'solu-npk-12-12-36'].includes(slug) ? 'water-soluble-npk'
    : ['solu-up', 'solu-map', 'solu-mkp'].includes(slug) ? 'phosphate-sources'
    : 'nitrogen-mg-k';
  matches[bucket].count++;
  if (matches[bucket].samples.length < 3) {
    matches[bucket].samples.push({ name: p.data.name[lang as 'en' | 'ar'], grade: p.data.grade });
  }
}
---

<section class="py-section-y bg-paper">
  <div class="stage-grid">
    <header class="col-span-12 col-start-2 mb-sp-9 flex items-end justify-between flex-wrap gap-sp-5">
      <div>
        <Kicker label={t('home.catalog.kicker')} />
        <h2 class="font-display text-5xl text-ink mt-sp-5 max-w-[20ch] leading-tight">{t('home.catalog.headline')}</h2>
      </div>
      <a href={lang === 'ar' ? '/ar/products' : '/products'} class="font-mono text-[11px] tracking-[0.22em] uppercase text-ink no-underline border-b border-ink pb-0.5">
        {t('home.catalog.full_catalog')} →
      </a>
    </header>

    <div class="col-span-12 col-start-2 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-sp-6 border-t border-ink pt-sp-7">
      {subcategories.map((sub, i) => {
        const data = matches[sub.id];
        return (
          <div class="flex flex-col border-t border-stone pt-sp-5">
            <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute">
              {String(i + 1).padStart(2, '0')} · {data.count} SKU{data.count === 1 ? '' : 's'}
            </span>
            <h3 class="font-display text-2xl text-ink mt-sp-3 mb-sp-5 leading-tight">
              {isAR ? sub.label_ar : sub.label_en}
            </h3>
            <ul class="list-none p-0 m-0 mb-sp-7 flex-1 space-y-3">
              {data.samples.map((s) => (
                <li>
                  <div class="font-sans text-sm text-ink">{s.name}</div>
                  <div class="font-mono text-[10.5px] tracking-[0.16em] uppercase text-mute mt-1">{s.grade}</div>
                </li>
              ))}
            </ul>
            <a href={lang === 'ar' ? '/ar/products' : '/products'} class="mt-auto font-mono text-[10.5px] tracking-[0.22em] uppercase text-ink no-underline border-b border-ink pb-0.5 self-start">
              {t('common.open_category')} →
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>
