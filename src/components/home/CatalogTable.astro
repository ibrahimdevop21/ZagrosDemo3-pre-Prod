---
// Catalog teaser — three product lines mapped from the three content collections.
// Counts are derived from collection length so they stay in sync with the catalog.
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isAR = lang === 'ar';

const [seedsCol, fertilizersCol, pesticidesCol] = await Promise.all([
  getCollection('seeds'),
  getCollection('fertilizers'),
  getCollection('pesticides'),
]);

const lines = [
  {
    slug: 'seeds',
    count: seedsCol.length,
    label_en: 'Seeds',
    label_ar: 'البذور',
    deck_en: 'Forage and vegetable seed lines.',
    deck_ar: 'خطوط بذور الأعلاف والخضار.',
    sources_en: 'Barenbrug · East West Seeds',
    sources_ar: 'Barenbrug · East West Seeds',
  },
  {
    slug: 'fertilizers',
    count: fertilizersCol.length,
    label_en: 'Fertilizers',
    label_ar: 'الأسمدة',
    deck_en: 'Water-soluble and specialty fertilizers.',
    deck_ar: 'أسمدة قابلة للذوبان وأسمدة خاصة.',
    sources_en: 'K+S · Agro Dragon',
    sources_ar: 'K+S · Agro Dragon',
  },
  {
    slug: 'pesticides',
    count: pesticidesCol.length,
    label_en: 'Pesticides',
    label_ar: 'المبيدات',
    deck_en: 'Insecticides, herbicides, fungicides.',
    deck_ar: 'مبيدات حشرية، أعشاب، فطرية.',
    sources_en: 'SAF · KZ · Kafr El Zayat',
    sources_ar: 'SAF · KZ · Kafr El Zayat',
  },
];

const productsHref = isAR ? '/ar/products' : '/products';
const lineHref = (slug: string) => (isAR ? `/ar/products/${slug}` : `/products/${slug}`);
---

<section class="py-section-y bg-paper">
  <div class="stage-grid">
    <header class="col-span-12 col-start-2 mb-sp-9 flex items-end justify-between flex-wrap gap-sp-5">
      <div>
        <Kicker label={t('home.catalog.kicker')} />
        <h2 class="font-display text-5xl text-ink mt-sp-5 max-w-[22ch] leading-tight">
          {t('home.catalog.headline')}
        </h2>
      </div>
      <a
        href={productsHref}
        class="font-mono text-[11px] tracking-[0.22em] uppercase text-ink no-underline border-b border-ink pb-0.5"
      >
        {t('home.catalog.full_catalog')} →
      </a>
    </header>

    <div class="col-span-12 col-start-2 grid grid-cols-1 md:grid-cols-3 gap-sp-7 border-t border-ink pt-sp-7">
      {lines.map((line, i) => (
        <article class="flex flex-col border-t border-stone pt-sp-5">
          <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute">
            {String(i + 1).padStart(2, '0')} · {line.count} SKU{line.count === 1 ? '' : 's'}
          </span>
          <h3 class="font-display text-3xl text-ink mt-sp-3 mb-sp-4 leading-tight">
            {isAR ? line.label_ar : line.label_en}
          </h3>
          <p class="font-sans text-base text-ink/80 leading-relaxed mb-sp-5 max-w-[34ch]">
            {isAR ? line.deck_ar : line.deck_en}
          </p>
          <div class="font-mono text-[10.5px] tracking-[0.18em] uppercase text-mute mb-sp-7">
            {isAR ? line.sources_ar : line.sources_en}
          </div>
          <a
            href={lineHref(line.slug)}
            class="mt-auto font-mono text-[10.5px] tracking-[0.22em] uppercase text-ink no-underline border-b border-ink pb-0.5 self-start"
          >
            {t('common.open_category')} →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
