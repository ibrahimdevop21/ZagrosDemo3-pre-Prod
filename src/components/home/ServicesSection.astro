---
/**
 * ServicesSection - Reusable services display component
 * Used on home page to show company services
 */
import PageWrapper from '../layout/PageWrapper.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Stack from '../layout/Stack.astro';

interface Props {
  title: string;
  services: string[];
  isArabic?: boolean;
}

const { title, services, isArabic = false } = Astro.props;
const dir = isArabic ? 'rtl' : 'ltr';
---

<Section spacing="lg" class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/30 to-transparent opacity-40"></div>
  <div class="absolute -left-1/4 top-0 w-1/2 h-1/2 bg-brand-accent/20 rounded-full blur-3xl"></div>
  <div class="absolute -right-1/4 bottom-0 w-1/2 h-1/2 bg-brand-accent/20 rounded-full blur-3xl"></div>
  <PageWrapper>
    <Stack spacing="xl">
      <Container narrow>
        <Stack spacing="md" class="text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-text-primary">
            {title}
          </h2>
          <div class="h-1.5 w-24 bg-bg-brand mx-auto rounded-full"></div>
        </Stack>
      </Container>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" dir={dir}>
        {services.map((service, index) => (
          <div class="group relative bg-bg-surface rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden">
            <div class="absolute inset-0 bg-brand-accent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative z-10">
              <div class="bg-bg-brand-muted w-16 h-16 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500">
                {index === 0 && (
                  <svg class="w-8 h-8 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                )}
                {index === 1 && (
                  <svg class="w-8 h-8 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                )}
                {index === 2 && (
                  <svg class="w-8 h-8 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                  </svg>
                )}
              </div>
              <h3 class:list={[
                "text-xl font-semibold text-text-primary mb-4 group-hover:text-text-brand transition-colors duration-300",
                { "text-right": isArabic }
              ]}>
                {service}
              </h3>
            </div>
          </div>
        ))}
      </div>
    </Stack>
  </PageWrapper>
</Section>
