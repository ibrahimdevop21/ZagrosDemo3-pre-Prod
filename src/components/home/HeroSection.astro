---
/**
 * Hero Section Component
 * Professional corporate hero with image carousel background
 * Clear value proposition with auto-rotating hero images
 */

import { getLocalizedPath } from '../../utils/navigation';
import HeroCarousel from './HeroCarousel';

interface Props {
  headline: string;
  subheadline: string;
  valueProposition: string;
  ctaPrimary: string;
  ctaSecondary: string;
  isArabic: boolean;
  lang: string;
}

const { headline, subheadline, valueProposition, ctaPrimary, ctaSecondary, isArabic, lang } = Astro.props;

// Hero images from public/hero folder
const heroImages = [
  '/hero/crop.webp',
  '/hero/crop2.webp',
  '/hero/irrigation.webp',
  '/hero/pest.webp',
  '/hero/vegetable.webp'
];
---

<section class="relative overflow-hidden h-screen">
  <!-- Hero Image Carousel Background -->
  <HeroCarousel client:only="react" images={heroImages} interval={5000} />

  <div class="relative h-full flex items-center mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 z-10">
    <div class="mx-auto max-w-4xl text-center w-full">
      <!-- Animated content with white text for image backgrounds -->
      <div class="space-y-6 animate-fade-up">
        <!-- Headline -->
        <h1 class={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight drop-shadow-lg ${isArabic ? 'font-arabic' : ''}`}>
          {headline}
        </h1>

        <!-- Subheadline -->
        <p class={`text-base sm:text-lg md:text-xl text-white/95 max-w-3xl mx-auto leading-relaxed drop-shadow-md ${isArabic ? 'font-arabic' : ''}`}>
          {subheadline}
        </p>

        <!-- Value Proposition -->
        <p class={`text-sm sm:text-base md:text-lg text-white/90 max-w-2xl mx-auto drop-shadow-md ${isArabic ? 'font-arabic' : ''}`}>
          {valueProposition}
        </p>

        <!-- CTAs - Side by side on all screen sizes -->
        <div class={`flex flex-row items-center justify-center gap-3 sm:gap-4 pt-4 ${isArabic ? 'flex-row-reverse' : ''}`}>
          <a
            href={getLocalizedPath(lang, 'contact')}
            class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-semibold text-white bg-brand-primary hover:bg-brand-primary-hover rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-105"
          >
            {ctaPrimary}
          </a>
          <a
            href={getLocalizedPath(lang, 'products')}
            class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 text-sm sm:text-base font-semibold text-white bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/40 rounded-lg shadow-lg hover:shadow-xl transition-all duration-200"
          >
            {ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out;
  }
</style>
