---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import PartnerCard from '../cards/PartnerCard.astro';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Show the four named brand houses on the homepage. The remaining 3
// (SAF / KZ — confirmation pending; Kafr El Zayat — Egypt insecticides)
// live on /partners and are surfaced there.
const FEATURED_SLUGS = ['k-plus-s', 'barenbrug', 'east-west-seeds', 'agro-dragon'] as const;

const all = await getCollection('partners');
const featured = FEATURED_SLUGS
  .map(slug => all.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const partnersHref = lang === 'ar' ? '/ar/partners' : '/partners';
const ctaLabel =
  lang === 'ar' ? `استعرض الموردين السبعة جميعاً ←` : `View all 7 suppliers →`;
---

<section class="py-section-y bg-paper relative">
  <div class="stage-grid">
    <div class="col-span-1 col-start-1 hidden lg:flex justify-end pe-sp-5">
      <span class="font-mono text-[10.5px] tracking-[0.4em] uppercase text-mute [writing-mode:vertical-rl] rotate-180">
        {t('home.sources.runner')}
      </span>
    </div>

    <header class="col-span-8 col-start-2">
      <Kicker label={t('home.sources.kicker')} accent="sienna" />
      <h2 class="font-display text-5xl text-ink mt-sp-5 max-w-[22ch] leading-tight">
        {t('home.sources.headline_a')}
        <em class="italic font-light text-sienna"> {t('home.sources.headline_b')}</em>
      </h2>
    </header>

    <div class="col-span-12 col-start-2 mt-sp-9 grid grid-cols-1 lg:grid-cols-2 gap-sp-7">
      {featured.map((partner) => <PartnerCard partner={partner} />)}
    </div>

    <div class="col-span-12 col-start-2 mt-sp-9 flex items-baseline justify-end border-t border-stone pt-sp-5">
      <a
        href={partnersHref}
        class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-ink border-b border-ink pb-0.5 no-underline"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
