---
/**
 * Zagros v3 — Section 08 World reach (Plan 7 rewrite).
 *
 * Real projected world map (Natural Earth 1) built at build time from
 * world-atlas/countries-110m.json via d3-geo + topojson-client. Output is
 * static SVG — zero runtime map JS, no tiles. Pin coordinates and country
 * paths share the SAME projection so they line up exactly.
 *
 * Pin styles (data-driven from src/data/world-reach.ts):
 *   - hq:     bullseye (signal-yellow ring + dot + ink center)
 *   - branch: small signal-yellow dot (non-HQ Sudan cities, city-level)
 *   - source: filled signal-yellow circle
 *   - market: rotated sienna square (diamond)
 *   - both:   circle + diamond overlaid (currently Egypt)
 *
 * Country fill tints (light) indicate role at the country level — supplier
 * countries lift in signal-yellow, markets in sienna, "both" composite.
 * Faint dashed lines from Sudan to source countries trace the import flow.
 *
 * Credentials block — uniform supplier-name slot per source country (9
 * cards). The slot's role is to demonstrate to the client CEO exactly what
 * names we have and exactly what's outstanding. TBC slots use a dashed
 * border + mute italic placeholder so the empty state is unmistakable.
 *
 * Scope note — demo-only build flag. Flip SHOW_SCOPE_NOTE to false before
 * the production launch.
 */
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import worldAtlas from 'world-atlas/countries-110m.json';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { countries, branches, sourceM49, marketM49 } from '../../data/world-reach';

// ── Build flags ─────────────────────────────────────────────────────────
const SHOW_SCOPE_NOTE = true; // demo build only — flip to false before production

// ── Locale + projection setup ───────────────────────────────────────────
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const VIEWBOX_W = 1000;
const VIEWBOX_H = 500;

const worldFeatures = feature(
  worldAtlas as any,
  (worldAtlas as any).objects.countries,
) as any;
const projection = geoNaturalEarth1().fitSize([VIEWBOX_W, VIEWBOX_H], worldFeatures);
const path = geoPath(projection);

const countryPaths = worldFeatures.features.map((f: any) => {
  const id = String(f.id);
  return {
    id,
    d: path(f) ?? '',
    isSource: sourceM49.has(id),
    isMarket: marketM49.has(id),
  };
});

const pinPositions = countries.map((c) => {
  const proj = projection([c.lon, c.lat]) ?? [0, 0];
  return { ...c, x: proj[0], y: proj[1] };
});

const branchPositions = branches.map((b) => {
  const proj = projection([b.lon, b.lat]) ?? [0, 0];
  return { ...b, x: proj[0], y: proj[1] };
});

const hqPin = pinPositions.find((p) => p.alpha2 === 'sd')!;
const sourceCards = countries.filter((c) => c.role === 'source' || c.role === 'both');

const flagEmoji = (alpha2: string) =>
  alpha2
    .toUpperCase()
    .replace(/./g, (ch) => String.fromCodePoint(0x1f1a5 + ch.charCodeAt(0)));
---

<section class="bg-paper border-t border-ink py-section-y">
  <div class="container-spine">
  <span
    class="font-mono text-[10.5px] tracking-[0.24em] uppercase text-mute inline-flex items-center gap-2.5 mb-sp-5"
  >
    <span class="w-6 h-px bg-mute inline-block"></span>
    {t('home.v3branches.label')}
  </span>

  <h2
    class="font-display italic font-light text-[clamp(32px,5vw,56px)] leading-[0.95] text-ink max-w-[28ch] mb-head-to-content"
  >
    {t('home.v3branches.headline_phrase')}{' '}
    <span class="text-sienna not-italic">{t('home.v3branches.headline_accent')}</span>
  </h2>

  <!-- Map + branches aside -->
  <div
    class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(260px,1fr)] gap-sp-5 lg:gap-sp-6 items-start mb-sp-9"
  >
    <!-- Map block -->
    <div class="bg-paper-light border border-stone p-sp-4 sm:p-sp-5 flex flex-col">
      <svg
        viewBox={`0 0 ${VIEWBOX_W} ${VIEWBOX_H}`}
        class="w-full h-auto block"
        style="direction: ltr;"
        aria-label="Zagros Trading — world reach map showing source countries, markets, and Sudan branches"
        role="img"
      >
        <!-- Country boundaries with role-based fill tints -->
        <g stroke="rgb(var(--color-mute) / 0.35)" stroke-width="0.5" stroke-linejoin="round">
          {countryPaths.map((f: any) => (
            <path
              d={f.d}
              fill={
                f.isSource && f.isMarket
                  ? 'rgb(var(--color-signal) / 0.22)'
                  : f.isSource
                  ? 'rgb(var(--color-signal) / 0.14)'
                  : f.isMarket
                  ? 'rgb(var(--color-sienna) / 0.16)'
                  : 'rgb(var(--color-stone) / 0.5)'
              }
            />
          ))}
        </g>

        <!-- Import-flow lines from Sudan HQ to each source country -->
        <g
          stroke="rgb(var(--color-signal) / 0.4)"
          stroke-width="0.7"
          stroke-dasharray="2 3"
          stroke-linecap="round"
          fill="none"
        >
          {pinPositions
            .filter((p) => p.role === 'source' || p.role === 'both')
            .map((p) => (
              <line x1={hqPin.x} y1={hqPin.y} x2={p.x} y2={p.y} />
            ))}
        </g>

        <!-- Sudan branch pins (small, non-HQ cities) — drawn first so country pins overlay -->
        {branchPositions
          .filter((b) => !b.isHq)
          .map((b, i) => (
            <g
              data-pin
              transform={`translate(${b.x} ${b.y})`}
              style={`--pin-delay: ${(i + 20) * 45}ms`}
            >
              <circle
                r="2.6"
                fill="rgb(var(--color-signal) / 0.65)"
                stroke="rgb(var(--color-ink))"
                stroke-width="0.4"
              />
            </g>
          ))}

        <!-- Country-level pins -->
        {pinPositions.map((p, i) => (
          <g
            data-pin
            transform={`translate(${p.x} ${p.y})`}
            style={`--pin-delay: ${i * 45}ms`}
          >
            {p.role === 'hq' && (
              <>
                <circle r="13" fill="none" stroke="rgb(var(--color-signal))" stroke-width="1.4" opacity="0.55" />
                <circle r="7" fill="rgb(var(--color-signal))" />
                <circle r="2.5" fill="rgb(var(--color-ink))" />
              </>
            )}
            {p.role === 'both' && (
              <>
                <circle r="5.5" fill="rgb(var(--color-signal))" />
                <rect
                  x="-3.5"
                  y="-3.5"
                  width="7"
                  height="7"
                  transform="rotate(45)"
                  fill="rgb(var(--color-sienna))"
                  stroke="rgb(var(--color-ink))"
                  stroke-width="0.5"
                />
              </>
            )}
            {p.role === 'source' && (
              <circle
                r="5"
                fill="rgb(var(--color-signal))"
                stroke="rgb(var(--color-ink))"
                stroke-width="0.55"
              />
            )}
            {p.role === 'market' && (
              <rect
                x="-4"
                y="-4"
                width="8"
                height="8"
                transform="rotate(45)"
                fill="rgb(var(--color-sienna))"
                stroke="rgb(var(--color-ink))"
                stroke-width="0.55"
              />
            )}
          </g>
        ))}
      </svg>

      <!-- Legend -->
      <div
        class="mt-sp-4 flex flex-wrap gap-x-sp-4 gap-y-sp-2 font-mono text-[9.5px] tracking-[0.2em] uppercase text-mute"
      >
        <span class="inline-flex items-center gap-2">
          <span class="relative w-3.5 h-3.5 inline-block">
            <span class="absolute inset-0 rounded-full border border-signal opacity-55"></span>
            <span class="absolute inset-[3px] rounded-full bg-signal"></span>
          </span>
          {t('home.v3branches.legend_hq')}
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-signal/65 border border-ink/40 inline-block"></span>
          {t('home.v3branches.legend_branch')}
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-signal border border-ink/60 inline-block"></span>
          {t('home.v3branches.legend_supplier')}
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-3 h-3 bg-sienna border border-ink/60 rotate-45 inline-block"></span>
          {t('home.v3branches.legend_market')}
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="relative w-3.5 h-3.5 inline-block">
            <span class="absolute inset-0 m-auto w-3 h-3 rounded-full bg-signal"></span>
            <span class="absolute inset-0 m-auto w-2.5 h-2.5 bg-sienna rotate-45"></span>
          </span>
          {t('home.v3branches.legend_both')}
        </span>
      </div>

      <p class="mt-sp-4 font-mono text-[10px] tracking-[0.22em] uppercase text-mute m-0">
        {t('home.v3branches.markets_caption')}
      </p>
    </div>

    <!-- Branches aside -->
    <aside class="bg-ink text-paper p-sp-5 sm:p-sp-6 flex flex-col gap-sp-4 self-start">
      <h3 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-paper/65 m-0">
        {t('home.v3branches.branches_label')}
      </h3>
      <ul class="list-none m-0 p-0 flex flex-col">
        {branches.map((b, i) => (
          <li class="grid grid-cols-[28px_1fr_auto] gap-sp-3 items-baseline py-sp-3 border-b border-paper/15 last:border-b-0">
            <span class="font-display italic text-[18px] text-paper/55 leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="font-display italic text-[clamp(16px,2vw,18px)] text-paper leading-tight">
              {lang === 'ar' ? b.city_ar : b.city_en}
            </span>
            <span
              class:list={[
                'font-mono text-[8.5px] tracking-[0.22em] uppercase',
                b.isHq ? 'text-signal' : 'text-paper/55',
              ]}
            >
              {b.isHq ? t('home.v3branches.hq') : t('home.v3branches.branch')}
            </span>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <!-- Credentials block header -->
  <h3
    class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-5"
  >
    <span class="inline-block w-6 h-px bg-mute align-middle me-2"></span>
    {t('home.v3branches.credentials_label')}
  </h3>

  <!-- Credentials grid (9 cards = 3×3 at lg+) -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-sp-3 mb-sp-7"
  >
    {sourceCards.map((c, i) => {
      const conf = c.confidence!;
      const isTbc = conf === 'tbc';
      return (
        <article
          class:list={[
            'flex flex-col gap-sp-3 p-sp-5 bg-paper border transition-colors',
            isTbc ? 'border-stone' : 'border-ink/15 hover:border-ink/55',
          ]}
        >
          <header class="flex items-baseline gap-sp-3">
            <span class="text-[28px] leading-none" aria-hidden="true" style="direction: ltr;">
              {flagEmoji(c.alpha2)}
            </span>
            <h4 class="font-display italic text-[clamp(20px,2.2vw,24px)] text-ink leading-tight m-0">
              {lang === 'ar' ? c.name_ar : c.name_en}
            </h4>
          </header>

          <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-mute flex items-baseline gap-2">
            <span>{t('home.v3branches.product_line_label')}</span>
            <span class="text-ink not-italic">
              {lang === 'ar' ? c.product_line_ar : c.product_line_en}
            </span>
          </div>

          <!-- Supplier slot -->
          <div
            class:list={[
              'mt-sp-2 flex flex-col gap-1.5 px-sp-4 py-sp-3 border',
              isTbc
                ? 'border-dashed border-mute/55 bg-paper-light'
                : 'border-stone bg-paper-light',
            ]}
          >
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-mono text-[9px] tracking-[0.24em] uppercase text-mute">
                {t('home.v3branches.slot_label')}
              </span>
              {conf === 'aggregate' && (
                <span class="font-mono text-[9px] tracking-[0.24em] uppercase text-sienna/85">
                  {t('home.v3branches.slot_chip_aggregate')}
                </span>
              )}
            </div>
            <span
              class:list={[
                'leading-tight',
                conf === 'aggregate'
                  ? 'font-sans not-italic text-ink text-[clamp(15px,1.5vw,17px)]'
                  : isTbc
                  ? 'font-display italic text-mute text-[clamp(16px,1.7vw,19px)]'
                  : 'font-display italic text-ink text-[clamp(16px,1.7vw,19px)]',
              ]}
              dir={c.supplier_name ? 'ltr' : undefined}
            >
              {c.supplier_name ?? t('home.v3branches.slot_tbc')}
            </span>
            {conf === 'partial' && (
              <span class="font-mono text-[9.5px] tracking-[0.16em] uppercase text-mute/85">
                {t('home.v3branches.slot_partial')}
              </span>
            )}
            {conf === 'aggregate' && (
              <span class="font-mono text-[9.5px] tracking-[0.16em] uppercase text-mute/85">
                {t('home.v3branches.slot_aggregate')}
              </span>
            )}
          </div>
        </article>
      );
    })}
  </div>

  {SHOW_SCOPE_NOTE && (
    <aside
      class="flex flex-col sm:flex-row items-start sm:items-baseline gap-sp-3 sm:gap-sp-4 px-sp-5 py-sp-4 border border-dashed border-sienna/55 bg-paper-light"
    >
      <span class="font-mono text-[9px] tracking-[0.24em] uppercase text-sienna whitespace-nowrap">
        {t('home.v3branches.scope_note_label')}
      </span>
      <p class="font-sans text-[13px] leading-relaxed text-mute m-0 max-w-[68ch]">
        {t('home.v3branches.scope_note_body')}
      </p>
    </aside>
  )}
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-pin] {
      opacity: 0;
      animation: pin-fade 500ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--pin-delay, 0ms);
    }
    @keyframes pin-fade {
      from { opacity: 0; transform-origin: center; }
      to   { opacity: 1; }
    }
  }
</style>
