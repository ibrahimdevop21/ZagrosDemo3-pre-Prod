---
/**
 * CompanySnapshot - Quick credibility indicators
 * Displays key company facts for immediate trust-building
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Stack from '../layout/Stack.astro';

interface Props {
  established: string;
  specialization: string;
  coverage: string;
  partnerships: string;
  isArabic?: boolean;
}

const { established, specialization, coverage, partnerships, isArabic = false } = Astro.props;
---

<Section spacing="md" background="muted">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', text: established },
        { icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', text: specialization },
        { icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z', text: coverage },
        { icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z', text: partnerships }
      ].map(item => (
        <div class="bg-bg-surface rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow duration-300">
          <div class="flex flex-col items-center text-center gap-4">
            <div class="p-3 bg-bg-brand-muted rounded-lg">
              <svg class="w-8 h-8 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <p class:list={["text-sm font-medium text-text-primary", { "text-right": isArabic }]}>
              {item.text}
            </p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
