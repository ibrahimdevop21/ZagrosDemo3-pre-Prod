---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import statsData from '../../data/home-stats.json';
import PhotoStamp from '../editorial/PhotoStamp.astro';
import MonoDataline from '../editorial/MonoDataline.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isAR = lang === 'ar';

// All four KPI tiles are derived from real company data via home-stats.json.
// Source of truth: src/data/company.ts (years, branches, suppliers) and
// the three product collections (skus). Source-note inside home-stats.json.
const datalineItems = statsData.stats.map((s) => ({
  label: isAR ? s.label_ar : s.label_en,
  value: s.value,
}));
---

<section class="relative bg-paper">
  <div class="relative w-full">
    <img
      src="/photos/illustrative-hero-canal.jpg"
      alt={t('home.hero.photo_alt')}
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="block w-full h-[min(78vh,820px)] object-cover"
    />
    <PhotoStamp issue="03" year="2026" edition={t('home.hero.edition_label')} />
  </div>

  <div class="stage-grid -mt-sp-9 relative">
    <h1
      class="col-span-12 col-start-2 font-display text-[clamp(40px,8vw,128px)] leading-[0.92] text-ink m-0 mb-sp-7 max-w-[18ch]"
    >
      {t('home.hero.headline_a')}
      <em class="italic font-light text-sienna"> {t('home.hero.headline_b')}</em>
    </h1>

    <p class="col-span-7 col-start-2 font-sans text-lg leading-relaxed text-ink/80 max-w-[60ch] mb-sp-7">
      {t('home.hero.deck')}
    </p>

    <div class="col-span-12 col-start-2 bg-ink text-paper px-page-x py-sp-6 -mx-page-x mt-sp-6">
      <MonoDataline items={datalineItems} />
    </div>
  </div>
</section>
