---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ReportCard from '../cards/ReportCard.astro';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reports = await getCollection('field-reports', ({ data }) => data.featured === true);
const featured = reports[0];
---

{featured && (
  <section class="py-section-y bg-paper relative">
    <div class="stage-grid">
      <div class="col-span-2 col-start-2">
        <Kicker label={t('home.featured.kicker')} accent="sienna" />
        <span class="block font-display italic text-mute mt-sp-5 text-2xl">§ {String(featured.data.issue).padStart(2, '0')}</span>
      </div>

      <div class="col-span-12 col-start-2 mt-sp-7">
        <ReportCard report={featured} variant="featured" />
      </div>
    </div>
  </section>
)}
