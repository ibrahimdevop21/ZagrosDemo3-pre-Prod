---
/**
 * DistributionNetwork - Client network overview
 * Social proof through distribution coverage
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Stack from '../layout/Stack.astro';

interface Props {
  title: string;
  description: string;
  isArabic?: boolean;
}

const { title, description, isArabic = false } = Astro.props;
---

<Section spacing="md">
  <Container>
    <Stack spacing="lg">
      <Stack spacing="md" class="text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-text-primary">{title}</h2>
        <div class="h-1 w-20 bg-bg-brand mx-auto rounded-full"></div>
      </Stack>

      <div class="bg-brand-accent rounded-xl p-12 text-center">
        <Stack spacing="lg">
          <div class="flex justify-center">
            <div class="p-6 bg-bg-surface rounded-full shadow-lg">
              <svg class="w-16 h-16 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
          </div>
          <p class:list={["text-xl text-text-primary font-medium max-w-3xl mx-auto leading-relaxed", { "text-right": isArabic }]}>
            {description}
          </p>
        </Stack>
      </div>
    </Stack>
  </Container>
</Section>
