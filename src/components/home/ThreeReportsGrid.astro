---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ReportCard from '../cards/ReportCard.astro';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('field-reports');
const featuredSlug = all.find(r => r.data.featured)?.slug;
const others = all
  .filter(r => r.slug !== featuredSlug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section class="py-section-y bg-paper">
  <div class="stage-grid">
    <header class="col-span-12 col-start-2 mb-sp-9 flex items-end justify-between gap-sp-6 flex-wrap">
      <div>
        <Kicker label={t('home.reports.kicker')} />
        <h2 class="font-display text-4xl text-ink mt-sp-5 max-w-[22ch]">{t('home.reports.headline')}</h2>
      </div>
      <a href={lang === 'ar' ? '/ar/field-reports' : '/field-reports'} class="font-mono text-[11px] tracking-[0.22em] uppercase text-ink no-underline border-b border-ink pb-0.5">
        {t('common.browse_archive')} →
      </a>
    </header>

    <div class="col-span-12 col-start-2 grid grid-cols-1 md:grid-cols-3 gap-sp-7">
      {others.map((report) => <ReportCard report={report} />)}
    </div>
  </div>
</section>
