---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import statsData from '../../data/home-stats.json';
import { companyData } from '../../data/company';
import Kicker from '../editorial/Kicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isAR = lang === 'ar';

const branches = companyData.branches;
---

<section class="bg-ink text-paper py-section-y relative">
  <div class="stage-grid">
    <header class="col-span-12 col-start-2 mb-sp-9">
      <Kicker label={t('home.numbers.kicker')} accent="signal" />
      <h2 class="font-display text-5xl text-paper mt-sp-5 max-w-[22ch] leading-tight">
        {t('home.numbers.headline')}
      </h2>
    </header>

    <div class="col-span-12 col-start-2 grid grid-cols-2 lg:grid-cols-4 gap-sp-7 mb-section-y">
      {statsData.stats.map((stat) => (
        <div class="border-t border-paper/20 pt-sp-5">
          <span class="font-display italic text-paper text-[clamp(64px,8vw,112px)] leading-none">{stat.value}</span>
          <div class="mt-sp-4 font-mono text-[10.5px] tracking-[0.24em] uppercase text-paper/75">
            {isAR ? stat.label_ar : stat.label_en}
          </div>
          <div class="mt-2 font-sans text-sm text-paper/55">
            {isAR ? stat.context_ar : stat.context_en}
          </div>
        </div>
      ))}
    </div>

    <div class="col-span-12 col-start-2">
      <h3 class="font-mono text-[10.5px] tracking-[0.24em] uppercase text-paper/55 mb-sp-5">{t('home.numbers.regions_label')}</h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {branches.map((b) => (
          <div class:list={['p-4 border', b.type === 'HQ' ? 'border-signal bg-signal/10' : 'border-paper/15']}>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-paper/55">
              {b.type === 'HQ' ? 'HQ' : '—'}
            </div>
            <div class="font-display italic text-paper text-xl mt-1">
              {isAR ? b.name.ar : b.name.en}
            </div>
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-paper/55 mt-2">
              {isAR ? b.city_ar : b.city_en}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
