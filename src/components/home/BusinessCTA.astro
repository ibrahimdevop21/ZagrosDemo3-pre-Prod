---
/**
 * BusinessCTA - Professional call to action
 * B2B-appropriate contact prompt
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Stack from '../layout/Stack.astro';

interface Props {
  title: string;
  description: string;
  buttonText: string;
  isArabic?: boolean;
}

const { title, description, buttonText, isArabic = false } = Astro.props;
---

<Section spacing="lg" background="brand">
  <Container narrow>
    <Stack spacing="lg" class="text-center">
      <Stack spacing="md">
        <h2 class="text-3xl md:text-4xl font-bold text-text-inverse">{title}</h2>
        <p class="text-lg text-text-inverse opacity-90 max-w-2xl mx-auto">
          {description}
        </p>
      </Stack>
      <div>
        <a 
          href={isArabic ? '/ar/contact' : '/contact'}
          class="inline-flex items-center gap-2 px-8 py-4 bg-bg-surface text-text-brand font-semibold rounded-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300"
        >
          {buttonText}
          <svg class:list={["w-5 h-5", { "rotate-180": isArabic }]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </Stack>
  </Container>
</Section>
