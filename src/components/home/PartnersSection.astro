---
/**
 * PartnersSection - Reusable partners display component
 * Shows international partners categorized by product type
 */
import PageWrapper from '../layout/PageWrapper.astro';
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Stack from '../layout/Stack.astro';

interface Partner {
  name: string;
  name_ar: string;
  logo: string;
  country: string;
}

interface Props {
  title: string;
  subtitle: string;
  seedsTitle: string;
  fertilizersTitle: string;
  pesticidesTitle: string;
  seedsPartners: Partner[];
  fertilizersPartners: Partner[];
  pesticidesPartners: Partner[];
  isArabic?: boolean;
}

const { 
  title, 
  subtitle, 
  seedsTitle, 
  fertilizersTitle, 
  pesticidesTitle,
  seedsPartners, 
  fertilizersPartners, 
  pesticidesPartners,
  isArabic = false 
} = Astro.props;
---

<Section spacing="sm" background="muted">
  <PageWrapper>
    <Stack spacing="lg">
      <Container narrow>
        <Stack spacing="sm" class="text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-text-brand">{title}</h2>
          <p class="text-text-secondary max-w-2xl mx-auto">{subtitle}</p>
        </Stack>
      </Container>

      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {[
            {
              title: seedsTitle,
              icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
              partners: seedsPartners
            },
            {
              title: fertilizersTitle,
              icon: 'M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z',
              partners: fertilizersPartners
            },
            {
              title: pesticidesTitle,
              icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
              partners: pesticidesPartners
            }
          ].map(category => (
            <div class="bg-bg-surface rounded-xl shadow-lg overflow-hidden">
              <div class="p-6 border-b border-border-default">
                <div class:list={["flex items-center gap-4", { "flex-row-reverse": isArabic }]}>
                  <div class="p-3 bg-bg-brand-muted rounded-lg">
                    <svg class="w-6 h-6 text-text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={category.icon} />
                    </svg>
                  </div>
                  <h3 class:list={["text-xl font-bold text-text-primary", { "text-right": isArabic }]}>{category.title}</h3>
                </div>
              </div>
              <div class="p-6">
                <div class="grid grid-cols-1 gap-6">
                  {category.partners.map(partner => (
                    <div class="group p-4 rounded-lg hover:bg-bg-surface-hover transition-all duration-300">
                      <div class:list={["flex items-center gap-4", { "flex-row-reverse": isArabic }]}>
                        <div class="relative w-16 h-16 bg-bg-surface rounded-lg p-2 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                          <img
                            src={`/partners/${partner.logo}`}
                            alt={isArabic ? partner.name_ar : partner.name}
                            class="w-12 h-12 object-contain"
                            loading="lazy"
                          />
                        </div>
                        <div class:list={[{ "text-right": isArabic }]}>
                          <h4 class="font-semibold text-text-primary group-hover:text-text-brand transition-colors duration-300">{isArabic ? partner.name_ar : partner.name}</h4>
                          <p class="text-sm text-text-secondary">{partner.country}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </Stack>
  </PageWrapper>
</Section>
