---
import compatibilityData from '../../data/compatibility.json';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  productSlug: string;
}
const { productSlug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProducts = await getCollection('products');
const current = allProducts.find(p => p.slug === productSlug);
const isSeed = current?.data.category === 'forage_seed';

const entry = (compatibilityData as Record<string, any>)[productSlug];
const incompatibleSlugs: string[] = entry?.incompatible ?? [];
const compatibleSlugs: string[] = allProducts
  .map(p => p.slug)
  .filter(s => s !== productSlug && !incompatibleSlugs.includes(s));

const incompatibleNames = incompatibleSlugs.map(s => allProducts.find(p => p.slug === s)?.data.name[lang as 'en' | 'ar'] ?? s);
const compatibleNames = compatibleSlugs.map(s => allProducts.find(p => p.slug === s)?.data.name[lang as 'en' | 'ar'] ?? s);
const reasons: Record<string, string> = entry?.reasons ?? {};
const chemistryNotes = (compatibilityData as any)._chemistry_notes ?? {};
---

<section class="py-section-y bg-paper" aria-label={t('product.compatibility.label')}>
  <div class="stage-grid">
    <header class="col-span-12 col-start-2 mb-sp-7 border-s-4 border-sienna ps-sp-5">
      <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-sienna">{t('product.compatibility.kicker')}</span>
      <h2 class="font-display text-4xl text-ink mt-sp-3 leading-tight max-w-[24ch]">
        {isSeed ? t('product.compatibility.seed_note_headline') : t('product.compatibility.headline')}
      </h2>
    </header>

    {isSeed ? (
      <p class="col-span-9 col-start-2 font-sans text-base text-ink/80 leading-relaxed max-w-[60ch]">
        {t('product.compatibility.seed_note_body')}
      </p>
    ) : (
      <>
        <div class="col-span-6 col-start-2">
          <h3 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-4">{t('product.compatibility.compatible')}</h3>
          <ul class="list-none p-0 m-0 space-y-3">
            {compatibleNames.length === 0 && <li class="font-sans text-sm text-mute">—</li>}
            {compatibleNames.map((n) => (
              <li class="flex items-baseline gap-3 font-sans text-base text-ink">
                <span class="text-field" aria-hidden="true">✓</span>{n}
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-6 col-start-8">
          <h3 class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute mb-sp-4">{t('product.compatibility.incompatible')}</h3>
          <ul class="list-none p-0 m-0 space-y-3">
            {incompatibleNames.length === 0 && <li class="font-sans text-sm text-mute">—</li>}
            {incompatibleSlugs.map((slug, i) => (
              <li>
                <div class="flex items-baseline gap-3 font-sans text-base text-ink">
                  <span class="text-sienna" aria-hidden="true">✕</span>{incompatibleNames[i]}
                </div>
                {reasons[slug] && (
                  <div class="ms-6 mt-1 font-mono text-[10.5px] tracking-[0.10em] text-mute">
                    {chemistryNotes[reasons[slug]] ?? reasons[slug]}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>

        {entry?.notes && (
          <aside class="col-span-12 col-start-2 mt-sp-7 p-sp-5 border border-sienna/40 bg-sienna/5">
            <p class="font-sans text-base text-ink m-0">{entry.notes}</p>
          </aside>
        )}
      </>
    )}

    <aside class="col-span-12 col-start-2 mt-sp-5 p-sp-5 border border-signal bg-signal/15">
      <p class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-ink m-0 leading-relaxed">
        <strong>{t('product.compatibility.universal_rule_label')}</strong> · {(compatibilityData as any)._universal_rule}
      </p>
    </aside>
  </div>
</section>
