---
/**
 * Products Page Hero Section
 * Hero carousel with K+ product images
 */

import HeroCarousel from '../home/HeroCarousel';

interface Props {
  title: string;
  subtitle: string;
  isArabic: boolean;
}

const { title, subtitle, isArabic } = Astro.props;

// K+ Product images from public/kpluss folder
const heroImages = [
  '/kpluss/image-01.webp',
  '/kpluss/image-02.webp',
  '/kpluss/image-03.webp',
  '/kpluss/image-04.webp',
  '/kpluss/image-05.webp',
  '/kpluss/image-06.webp',
  '/kpluss/image-07.webp',
  '/kpluss/image-08.webp',
  '/kpluss/image-09.webp',
  '/kpluss/image-010.webp',
  '/kpluss/image-011.webp',
  '/kpluss/image-012.webp'
];
---

<section class="relative overflow-hidden h-[50vh] min-h-[400px] sm:h-[55vh] md:h-[65vh] max-h-[700px]">
  <!-- Hero Image Carousel Background -->
  <HeroCarousel client:load images={heroImages} interval={4000} />

  <!-- Overlay for better text readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60 z-[5]"></div>

  <div class="relative h-full flex items-center justify-center mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 z-10 py-8">
    <div class="mx-auto max-w-4xl text-center w-full">
      <!-- Animated content -->
      <div class="space-y-3 sm:space-y-4 md:space-y-6 animate-fade-up">
        <!-- Title -->
        <h1 class={`text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight drop-shadow-lg px-2 ${isArabic ? 'font-arabic' : ''}`}>
          {title}
        </h1>

        <!-- Subtitle -->
        <p class={`text-sm sm:text-base md:text-lg lg:text-xl text-white/95 max-w-2xl mx-auto leading-relaxed drop-shadow-md px-4 ${isArabic ? 'font-arabic' : ''}`}>
          {subtitle}
        </p>

        <!-- Product Count Badge -->
        <div class="flex justify-center pt-1 sm:pt-2">
          <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-brand-primary/90 backdrop-blur-sm text-white rounded-full text-xs sm:text-sm font-medium shadow-lg">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-accent-light flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span class={isArabic ? 'font-arabic' : ''}>
              {isArabic ? 'منتجات زراعية متخصصة' : 'Specialized Agricultural Products'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out;
  }
</style>
