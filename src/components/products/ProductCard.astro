---
/**
 * Backward-compat facade.
 *
 * The real card lives in FertilizerCard.astro. This file is kept so
 * existing import sites (`import ProductCard from './ProductCard.astro'`)
 * continue to work without churn.
 */
import type { CollectionEntry } from 'astro:content';
import FertilizerCard from './FertilizerCard.astro';

interface Props { product: CollectionEntry<'fertilizers'>; }
const { product } = Astro.props;
---
<FertilizerCard product={product} />
