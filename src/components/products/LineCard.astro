---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  line: 'seeds' | 'fertilizers' | 'pesticides';
  count: number;
  supplierCount: number;
  subcatCount: number;
  lang: Language;
  index?: number;
}
const { line, count, supplierCount, subcatCount, lang, index = 0 } = Astro.props;
const t = useTranslations(lang);
const href = lang === 'ar' ? `/ar/products/${line}` : `/products/${line}`;

const accent =
  line === 'seeds' ? 'text-field' :
  line === 'fertilizers' ? 'text-signal' :
  'text-sienna';

const ordinal = String(index + 1).padStart(2, '0');
---
<article class="flex flex-col bg-paper border border-stone min-h-[420px] hover:border-ink transition-colors">
  <a href={href} class="flex flex-col flex-1 p-sp-7 no-underline text-inherit">
    <header class="flex items-baseline justify-between mb-sp-7">
      <span class={`font-display italic font-light text-5xl leading-none ${accent}`}>{ordinal}</span>
      <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute">
        {t(`products.lines.${line}.label`)}
      </span>
    </header>

    <h3 class="font-display text-3xl text-ink leading-tight mb-sp-5 max-w-[18ch]">
      {t(`products.lines.${line}.headline`)}
    </h3>
    <p class="font-sans text-base text-ink/80 leading-relaxed mb-sp-7">
      {t(`products.lines.${line}.deck`)}
    </p>

    <dl class="grid grid-cols-3 gap-sp-4 mt-auto pt-sp-5 border-t border-stone">
      <div>
        <dt class="font-mono text-[10px] tracking-[0.22em] uppercase text-mute">{t(`products.lines.${line}.stat_skus`)}</dt>
        <dd class="font-display italic text-3xl text-ink leading-none mt-2 m-0">{count}</dd>
      </div>
      <div>
        <dt class="font-mono text-[10px] tracking-[0.22em] uppercase text-mute">{t(`products.lines.${line}.stat_suppliers`)}</dt>
        <dd class="font-display italic text-3xl text-ink leading-none mt-2 m-0">{supplierCount}</dd>
      </div>
      <div>
        <dt class="font-mono text-[10px] tracking-[0.22em] uppercase text-mute">{t(`products.lines.${line}.stat_subcats`)}</dt>
        <dd class="font-display italic text-3xl text-ink leading-none mt-2 m-0">{subcatCount}</dd>
      </div>
    </dl>

    <div class="mt-sp-7 font-mono text-[10.5px] tracking-[0.22em] uppercase text-ink border-b border-ink pb-0.5 self-start">
      {t('common.open_category')} →
    </div>
  </a>
</article>
