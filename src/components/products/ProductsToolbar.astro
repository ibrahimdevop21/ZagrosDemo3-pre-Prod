---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="bg-paper border-y border-stone py-sp-4" data-products-toolbar>
  <div class="container-spine">
    <label class="flex items-center gap-3 border-b border-ink/30 focus-within:border-ink py-1 max-w-[480px] min-w-0">
      <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-mute">{t('products.toolbar.search_label')}</span>
      <input
        type="search"
        data-products-search
        placeholder={t('products.toolbar.search_placeholder')}
        class="bg-transparent border-none font-sans text-base text-ink outline-none flex-1 min-w-0 placeholder:text-mute"
      />
    </label>
  </div>
</div>
