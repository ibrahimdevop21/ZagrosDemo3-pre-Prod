---
interface Props {
  name: string;
  grade: string;
  brand: 'K+S' | 'Barenbrug';
  colorToken?: string;
}
const { name, grade, brand, colorToken } = Astro.props;
const bg = brand === 'Barenbrug' ? 'var(--color-field)' : `var(--color-${colorToken ?? 'cn'}, var(--color-signal))`;
const fg = brand === 'Barenbrug' ? 'var(--color-paper)' : 'var(--color-ink)';
---
<svg viewBox="0 0 300 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`${name} bag mockup`} class="block w-full h-auto">
  <rect width="300" height="360" fill={bg} />
  <rect x="20" y="20" width="260" height="320" fill="none" stroke={fg} stroke-opacity="0.18" stroke-width="2" />

  <text x="40" y="60" font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing="2" fill={fg} opacity="0.7">{brand.toUpperCase()}</text>

  <text x="40" y="180" font-family="'Fraunces', serif" font-style="italic" font-weight="300" font-size="42" fill={fg}>{name}</text>

  <text x="40" y="230" font-family="'IBM Plex Mono', monospace" font-size="11" letter-spacing="2" fill={fg} opacity="0.8">{grade}</text>

  <line x1="40" y1="290" x2="260" y2="290" stroke={fg} stroke-opacity="0.25" />
  <text x="40" y="312" font-family="'IBM Plex Mono', monospace" font-size="8" letter-spacing="3" fill={fg} opacity="0.55">BAG MOCKUP · PENDING REAL PHOTO</text>
</svg>
