---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ProductCard from './ProductCard.astro';

interface Props { product: CollectionEntry<'products'>; }
const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection('products');
const sameSubcat = all.filter(p => p.slug !== product.slug && p.data.subcategory === product.data.subcategory);
const fallback = all.filter(p => p.slug !== product.slug && p.data.category === product.data.category);
const pool = sameSubcat.length >= 3 ? sameSubcat : [...sameSubcat, ...fallback.filter(p => !sameSubcat.includes(p))];
const picks = pool.slice(0, 3);
---

{picks.length > 0 && (
  <section class="py-section-y bg-stone/30">
    <div class="stage-grid">
      <header class="col-span-12 col-start-2 mb-sp-7">
        <span class="font-mono text-[10.5px] tracking-[0.22em] uppercase text-mute">{t('product.related.kicker')}</span>
        <h2 class="font-display text-3xl text-ink mt-sp-3">{t('product.related.headline')}</h2>
      </header>
      <div class="col-span-12 col-start-2 grid grid-cols-1 md:grid-cols-3 gap-sp-6">
        {picks.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
)}
