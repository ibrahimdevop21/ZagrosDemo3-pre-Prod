---
/**
 * Language Toggle Component
 * Minimal, compact design for utility zone placement
 * Displays: EN | عربي (with active state)
 */

import { getLangFromUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

// Function to get the corresponding URL for a language
function getUrlForLang(targetLang: string) {
  if (pathname === '/' || pathname === '/ar') {
    return targetLang === 'en' ? '/' : '/ar';
  }
  if (targetLang === 'en') {
    return pathname.replace(`/${currentLang}`, '');
  }
  return pathname.startsWith('/') ? `/${targetLang}${pathname.replace(`/${currentLang}`, '')}` : `/${targetLang}/${pathname}`;
}

const isArabic = currentLang === 'ar';
---

<div class="inline-flex items-center gap-1 text-sm font-medium" role="group" aria-label="Language selection">
  <!-- English -->
  <a
    href={getUrlForLang('en')}
    class={`px-2 py-1 rounded transition-all duration-200 ${
      !isArabic 
        ? 'text-text-brand bg-brand-accent pointer-events-none' 
        : 'text-text-secondary hover:text-text-brand hover:bg-bg-surface-hover'
    }`}
    aria-label="Switch to English"
    aria-current={!isArabic ? 'true' : 'false'}
  >
    EN
  </a>
  
  <!-- Separator -->
  <span class="text-text-tertiary" aria-hidden="true">|</span>
  
  <!-- Arabic -->
  <a
    href={getUrlForLang('ar')}
    class={`px-2 py-1 rounded transition-all duration-200 ${
      isArabic 
        ? 'text-text-brand bg-brand-accent pointer-events-none' 
        : 'text-text-secondary hover:text-text-brand hover:bg-bg-surface-hover'
    }`}
    aria-label="Switch to Arabic"
    aria-current={isArabic ? 'true' : 'false'}
  >
    عربي
  </a>
</div>
