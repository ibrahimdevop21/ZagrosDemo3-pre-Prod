---
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---
<div class="grid grid-cols-2 md:grid-cols-4 gap-x-sp-7 gap-y-sp-5 font-mono text-[10.5px] tracking-[0.22em] uppercase text-paper/60">
  {items.map(({ label, value }) => (
    <div class="flex flex-col gap-1.5">
      <span>{label}</span>
      <span class="font-display italic text-paper text-2xl leading-none tracking-normal normal-case">{value}</span>
    </div>
  ))}
</div>
